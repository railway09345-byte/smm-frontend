# ──────────────────────────────────────────────────────────────
# DOLLU AI Social Media Studio — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit actual secrets to version control.
# ──────────────────────────────────────────────────────────────

# ── Frontend (Vite) — safe to expose in browser ──────────────
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
VITE_APP_NAME="Social AI Studio"

# ── Backend-only secrets — NEVER prefix with VITE_ ───────────
# These must live exclusively on your backend server (Node/Express/FastAPI etc.)

# Instagram / Facebook (Meta for Developers)
# https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Required scopes: instagram_basic,pages_manage_posts,instagram_content_publish,
#                  publish_video,pages_read_engagement

# LinkedIn Marketing API
# https://developer.linkedin.com/docs/guide/v2/applications
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Required scopes: w_member_social,w_organization_social

# YouTube Data API v3 (Google Cloud Console)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Required scopes: https://www.googleapis.com/auth/youtube.upload
#                  https://www.googleapis.com/auth/youtube.readonly

# OAuth Redirect Base URL (backend)
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/auth/callback

# Session / token encryption
SESSION_SECRET=change-me-to-a-random-string
TOKEN_ENCRYPTION_KEY=change-me-to-32-char-random-key-here

# Database (for storing encrypted platform tokens & publishing queue)
DATABASE_URL=postgresql://user:password@localhost:5432/dollu_social
# Or use SQLite for development: DATABASE_URL=sqlite:./dev.db

# Publishing queue backend (optional — use if you add a job queue)
REDIS_URL=redis://localhost:6379
